# Copy to .env (git-ignored). Never commit real values.
# Where the database (and later screenshots) live. Default: ~/TradingPortal/data
TRADING_PORTAL_DATA_DIR=
# Derives the API-key vault cipher. `make dev-secrets` fills this in for local dev.
# Production (Fly) refuses to start without it: set it with `fly secrets set`.
TRADING_PORTAL_SECRET_KEY=
# development | production | test
TRADING_PORTAL_ENV=development
# WebAuthn relying party: the host the app is served from, and the allowed origins (JSON list).
TRADING_PORTAL_RP_ID=localhost
TRADING_PORTAL_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
