{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["~/Desktop/Replay Journal", "~/TradingPortal/samples"],
    "allow": [
      "Bash(make *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(rm -rf /tmp/tp-*)",
      "Bash(python3 *)",
      "Bash(backend/.venv/bin/*)",
      "Bash(.venv/bin/*)",
      "Bash(sleep *)",
      "Bash(kill *)",
      "Bash(pkill -f uvicorn*)",
      "Bash(lsof *)",
      "Bash(du *)",
      "Bash(unzip *)",
      "Bash(zipinfo *)",
      "Bash(sqlite3 /tmp/*)",
      "Bash(fly version*)",
      "Bash(fly auth whoami*)",
      "Read(~/Desktop/Replay Journal/**)",
      "Read(~/TradingPortal/samples/**)",
      "WebFetch",
      "WebSearch",
      "mcp__context7",
      "mcp__playwright",
      "mcp__chrome-devtools"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)",
      "Bash(fly secrets *)",
      "Bash(fly apps create *)",
      "Bash(fly volumes *)",
      "Bash(fly storage *)",
      "Read(~/ReplayJournal/data/**)",
      "Edit(~/ReplayJournal/**)",
      "Edit(~/Desktop/Replay Journal/**)",
      "Write(~/Desktop/Replay Journal/**)",
      "Edit(~/TradingPortal/samples/**)",
      "Read(.env)",
      "mcp__flyctl"
    ]
  }
}
